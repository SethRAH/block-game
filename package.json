{
  "name": "block-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ad-free, kid-friendly block puzzle PWA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
